# Copy this file to site.env and replace only the paths needed at your site.
# The installed Fullscope binary, bundled adapters/anchors, R scripts, and
# Rscript from PATH are discovered automatically and usually need no override.

# Required for a complete Stereo-seq run.
export ST_BARCODES_MAP="/path/to/ST_BarcodeMap"
export GENOME_FA="/path/to/reference/genome.fa"
export GENES_GTF="/path/to/reference/genes.gtf"

# Optional overrides.
# export FULLSCOPE_BIN="/custom/path/to/fullscope"
# export ADAPTER_FA="/custom/path/to/adapters.fa"
# export ANCHOR_FA="/custom/path/to/anchor.fa"
# export BAMBU_R="/custom/path/to/bambu_process.R"
# export MERGE_R="/custom/path/to/fs_merge_spatial_transcripts.R"
# export RSCRIPT_BIN="/custom/path/to/Rscript"
